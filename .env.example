# LLM API Keys (Set at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Provider & Model Configuration
LLM_PROVIDER=gemini       # Options: 'gemini', 'openai'
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Safety & Agent Guardrails
DRY_RUN=false              # If true, tools simulate destructive actions without making changes
AUTO_APPROVE=false         # If true, skips confirmation for dangerous operations
MAX_ITERATIONS=15          # Maximum ReAct loops per user task
